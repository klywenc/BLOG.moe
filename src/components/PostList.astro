---
import { formatDate, postUrl, type Post } from '../utils';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="posts">
  {posts.map((post) => (
    <li>
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <div>
        <a href={postUrl(post)} class="title">
          {post.data.title}
          {post.data.draft && <span class="draft">draft</span>}
        </a>
        <p class="desc">{post.data.description}</p>
      </div>
    </li>
  ))}
</ul>

<style>
  .posts { list-style: none; margin: 0; padding: 0; }
  li {
    display: grid;
    grid-template-columns: 6.2rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
  }
  li + li { border-top: 1px solid var(--border); }
  li::marker { content: none; }
  time {
    font-family: var(--font-mono);
    font-size: .8rem;
    color: var(--muted);
    padding-top: .25rem;
  }
  .title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.08rem;
    color: var(--fg-strong);
    text-decoration: none;
  }
  .title:hover { color: var(--purple); }
  .desc { margin: .2rem 0 0; font-size: .93rem; color: var(--muted); line-height: 1.6; }
  .draft {
    font-family: var(--font-mono);
    font-size: .7rem;
    margin-left: .4rem;
    padding: 0 .4rem;
    border-radius: 4px;
    background: var(--pink-soft);
    color: var(--pink);
    vertical-align: middle;
  }
  @media (max-width: 30rem) {
    li { grid-template-columns: 1fr; gap: .1rem; }
  }
</style>
