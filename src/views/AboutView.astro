---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localize, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const specs = {
  en: [
    ['os', 'Windows, Linux, Mac'],
    ['editor', 'vscode, nano'],
    ['langs', 'c/c++, rust, erlang, typescript'],
    ['likes', 'low-level stuff, retro hardware, Pipeline Punch Monster,'],
    ['dislikes', 'AI-Slop and AI in general, Life, Guys who pretends that they are smarter, than they really are,'],
  ],
  pl: [
    ['os', 'Windows, Linux, Mac'],
    ['distro', 'CachyOS - main, RHEL - Mini server, Fedora - Workstation'],
    ['edytor', 'vscode / nano'],
    ['języki', 'c, rust, erlang, typescript, ale jezyk to tylko narzedzie'],
    ['lubię', 'niskopoziomowe rzeczy, stary sprzęt, Różowego Monstera'],
    ['nie lubię', 'AI Slopu i AI gówna, Life, RLudzi którzy wyżej srają niż dupę mają'],
  ],
}[lang];
---

<BaseLayout title={t('about.title')}>
  <p class="label">{t('about.title')}</p>
  <h1>Megu</h1>

  {lang === 'en' ? (
    <>
      <p>
        This is where I write about software, hardware and programming, mostly the
        low-level, poke-it-until-it-breaks kind. Expect deep dives, debugging stories,
        half-finished side projects and the occasional rant, my jorney of learning how to
        code low level stuffs in AI era, and how to adapt to that shit
      </p>
      <p>
        Everything here is my own opinion and probably wrong in at least one interesting
        way. If you spot it, tell me.
        B.Eng in Computer Science at <a href="https://study.ans-elblag.pl/">University of Applied Sciences in Elbląg</a>
        
      </p>
    </>
  ) : (
    <>
      <p>
        Tutaj piszę o oprogramowaniu, sprzęcie i programowaniu, głównie tym niskopoziomowym,
        w stylu „dłubać, aż się zepsuje”. Będą głębokie analizy, historie z debugowania,
        niedokończone projekty i od czasu do czasu jakiś rant.
      </p>
      <p>
        Wszystko tu to moje zdanie i pewnie w co najmniej jednym ciekawym miejscu jest
        błędne. Jak coś znajdziesz, daj znać.
        Inżynier Informatyki <a href="https://ans-elblag.pl/">Akademia Nauk Stosowanych w Elblągu</a>
      </p>
    </>
  )}

  <dl class="specs">
    {specs.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
  </dl>

  <p class="links">
    <a href="https://github.com/">github</a> · <a href={localize(lang, '/rss.xml')}>rss</a>
  </p>
</BaseLayout>

<style>
  .label { margin-top: 1rem; }
  .specs {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: .3rem 1.2rem;
    margin: 2rem 0;
    padding: 1rem 1.2rem;
    border-radius: var(--radius);
    background: var(--bg-soft);
    font-family: var(--font-mono);
    font-size: .85rem;
  }
  dt { color: var(--pink); }
  dd { margin: 0; }
  .links { font-family: var(--font-head); font-size: .9rem; }
</style>
