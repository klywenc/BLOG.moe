---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../utils';
import { localize, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getPosts(lang);
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title={t('tags.title')} description={t('tags.description')}>
  <p class="label">{t('tags.title')}</p>
  <div class="cloud">
    {tags.map(([tag, n]) => (
      <a class="tag" href={localize(lang, `/tags/${tag}/`)}>{tag} <span class="n">{n}</span></a>
    ))}
  </div>
</BaseLayout>

<style>
  .label { margin-top: 1rem; }
  .cloud { display: flex; flex-wrap: wrap; gap: .5rem; }
  .cloud .tag { font-size: .88rem; padding: .2rem .75rem; }
  .n { color: var(--muted); font-size: .8em; }
</style>
